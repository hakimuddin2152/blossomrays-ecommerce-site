    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "resend": "^6.18.1",
    "rxjs": "~7.8.0",
    "stripe": "^17.3.0",
    "tailwind-merge": "^2.5.4",
    "tslib": "^2.3.0",
    "zod": "^3.23.8",
